# Foliq self-hosted stack — copy to `.env` and replace every
# CHANGE_ME value before the first deployment.

# PostgreSQL stays inside the Compose network. The password is interpolated into
# DATABASE_URL, so use URL-safe characters only: letters, numbers, `.`, `_`, `~`, `-`.
POSTGRES_USER=ptd
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_URL_SAFE_PASSWORD
POSTGRES_DB=ptd

# Better Auth. Generate the secret with: openssl rand -base64 32
# For direct local access keep both origins on http://localhost:8080. Behind a
# public HTTPS proxy, set both to the public origin, e.g. https://foliq.example.com.
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PTD_WEB_ORIGIN=http://localhost:8080

# Optional comma-separated administrator emails. Administrators are excluded
# from demo-data resets; an empty value means this deployment has no admins.
PTD_ADMIN_EMAILS=owner@example.com

# When true, the marketing landing page is public and non-admin templates are
# restored to one example at 00:00 UTC each day. Keep false for normal self-hosting.
PTD_DEMO_MODE=false

# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# Public Web binding. Use 127.0.0.1 when Caddy/Nginx/Traefik runs on this host.
BIND_ADDRESS=0.0.0.0
WEB_PORT=8080

# Images published by .github/workflows/ci.yml. Pin IMAGE_TAG to a full
# sha-<commit> tag for reproducible production deploys and rollback.
WEB_IMAGE_REPOSITORY=ghcr.io/royians/print-template-designer-web
SERVER_IMAGE_REPOSITORY=ghcr.io/royians/print-template-designer-server
IMAGE_TAG=latest

# PDF renderer limits. The Server container uses a Chromium version matched to
# playwright-core and reaches the internal Web render bundle through Compose.
PTD_OUTPUT_MAX_CONCURRENCY=2
PTD_OUTPUT_TIMEOUT_MS=30000

# Optional while GHCR packages are private. Prefer shell/server secret-store
# environment variables; the token needs only read:packages.
# GHCR_USERNAME=your-github-username
# GHCR_TOKEN=github_pat_xxx
