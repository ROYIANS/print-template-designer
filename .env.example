# Public port exposed by Docker Compose.
WEB_PORT=8080

# GHCR image built by .github/workflows/ci.yml.
IMAGE_REPOSITORY=ghcr.io/royians/print-template-designer-web
# `latest` follows the repository default branch. Pin sha-<full-commit-sha> for releases/rollback.
IMAGE_TAG=latest

# Optional: only required while the GHCR package is private.
# Prefer exporting these in the shell or a server secret store instead of saving the token here.
# The token only needs the `read:packages` permission.
# GHCR_USERNAME=your-github-username
# GHCR_TOKEN=github_pat_xxx
