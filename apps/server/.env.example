DATABASE_URL=postgresql://ptd:change-me@127.0.0.1:5432/ptd?schema=public
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
PTD_WEB_ORIGIN=http://localhost:5173
# Local development only. When true, both origins above must use localhost,
# 127.0.0.1, or [::1], and NODE_ENV must not be production.
PTD_DEV_AUTH_BYPASS=false
PTD_ADMIN_EMAILS=owner@example.com
PTD_DEMO_MODE=false
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
PTD_TRUST_PROXY=false

# Deterministic PDF output. playwright-core does not download Chromium locally;
# point this to an installed Chromium executable when using PDF export outside Docker.
PTD_OUTPUT_RENDER_URL=http://127.0.0.1:5173/output-render.html
PTD_CHROMIUM_EXECUTABLE_PATH=
PTD_OUTPUT_MAX_CONCURRENCY=2
PTD_OUTPUT_TIMEOUT_MS=30000
