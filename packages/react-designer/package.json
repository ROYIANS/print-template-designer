{
  "name": "@ptd/react-designer",
  "version": "0.1.0",
  "description": "React designer component for Print Template Designer",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --noEmit"
  },
  "peerDependencies": {
    "@preact/signals-react": "^2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@preact/signals-react": "^2.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
